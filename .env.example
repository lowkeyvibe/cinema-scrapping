# Ruta al JSON de la service account de Google
GOOGLE_CREDENTIALS_FILE=service_account.json
# ID de la planilla (lo que va entre /d/ y /edit en la URL)
SPREADSHEET_ID=
# Monitor de Telegram (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot propio de Cinemark (opcional; si falta usa el de arriba)
TELEGRAM_BOT_TOKEN_CINEMARK=
TELEGRAM_CHAT_ID_CINEMARK=
